[user]
	email = joseph@holten.com
	name = Joseph Holten
	# The [S] subkey on the Yubikey, not the [C] primary (84D1 5BD8 …), which
	# stays offline and only certifies. Expires 2027-04-10 — signing starts
	# failing that day unless the expiry is extended first.
	signingkey = 9DAD40D0979D8CF0

[commit]
	# On everywhere. `set-touch sig on` means one physical touch per commit —
	# that is the point, not a side effect: a commit cannot be authored in your
	# name without you being at the machine.
	#
	# The corollary is that anything unattended CANNOT commit: an agent, a
	# script, a rebase --exec over twenty commits will each block on a touch
	# that is not coming. Those must pass --no-gpg-sign and leave signing to a
	# human before the push. See CLAUDE.md.
	gpgsign = true

[tag]
	# Same reasoning; tags are rarer, so the touch is cheaper still.
	gpgsign = true
[init]
	defaultBranch = master
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential]
	helper = /sbin/pass-git-helper
[core]
  excludesfile = ~/config/git/ignore
[url "git@github.com:"]
	# pushInsteadOf, not insteadOf: push needs credentials in any case, so it
	# always goes over ssh, while fetch of a public repo needs none and is left
	# on https. A private repo does need credentials to fetch — clone those with
	# a git@ URL from the start and this rewrite never applies to them.
	pushInsteadOf = https://github.com/
