#!/usr/bin/env python3
"""List compute nodes sorted by combined CPU + memory load (freest first).

Usage: cluster-load [hostname] [--all]

With a hostname argument, show only that node (excluded nodes like the
Opterons and pde-fs can still be queried this way). With --all, include
the excluded nodes in the overview.

Queries the cluster Prometheus through the Grafana datasource proxy at
login.cluster.math.kit.edu:3000 (anonymous access). Stdlib only.

Combined score = load5/cores + mem_used/mem_total, i.e. two 0..1 fractions
summed, so 0 = idle and ~2 = fully CPU- and memory-loaded.
"""

import argparse
import json
import ssl
import sys
import urllib.parse
import urllib.request

BASE = "https://login.cluster.math.kit.edu:3000/api/datasources/proxy/uid/TMSHzKmVz/api/v1"

# Opteron-era nodes and the file server are not general compute targets.
EXCLUDE = {"pde-fs.cluster.math.kit.edu", "pde01", "pde02", "pde06", "pde07"}

QUERIES = {
    "load5": "node_load5",
    "cpus": 'count by(instance)(node_cpu_seconds_total{mode="idle"})',
    # CPU busy fraction over the last two scrapes (~15s apart) — reacts
    # immediately when a job starts/ends, unlike the 5-minute load average.
    "busy_now": 'clamp_min(avg by(instance)(1 - irate(node_cpu_seconds_total{mode="idle"}[2m])), 0)',
    "mem_total": "node_memory_MemTotal_bytes",
    "mem_avail": "node_memory_MemAvailable_bytes",
}


def prom_query(query):
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    url = BASE + "/query?" + urllib.parse.urlencode({"query": query})
    with urllib.request.urlopen(url, timeout=15, context=ctx) as resp:
        data = json.load(resp)
    if data.get("status") != "success":
        sys.exit(f"prometheus query failed: {query}: {data}")
    return data["data"]["result"]


def main():
    parser = argparse.ArgumentParser(
        description="List compute nodes sorted by combined CPU + memory load (freest first)."
    )
    parser.add_argument("host", nargs="?", help="show only this node (bypasses exclusions)")
    parser.add_argument(
        "--all", action="store_true", help="include excluded nodes (Opterons, pde-fs)"
    )
    args = parser.parse_args()
    host = args.host

    nodes = {}
    for name, query in QUERIES.items():
        for r in prom_query(query):
            inst = r["metric"]["instance"].split(":")[0]
            if host is None and not args.all and inst in EXCLUDE:
                continue
            if host is not None and host not in (inst, inst.split(".")[0]):
                continue
            nodes.setdefault(inst, {})[name] = float(r["value"][1])

    if host is not None and not nodes:
        sys.exit(f"error: no metrics found for host {host!r}")

    rows = []
    for inst, v in nodes.items():
        if any(k not in v for k in QUERIES):
            print(f"warning: incomplete metrics for {inst}, skipping", file=sys.stderr)
            continue
        cpu_frac = v["load5"] / v["cpus"]
        mem_frac = (v["mem_total"] - v["mem_avail"]) / v["mem_total"]
        rows.append((cpu_frac + mem_frac, cpu_frac, mem_frac, inst, v))

    gib = 1024**3
    print(
        f"{'node':<8}{'cpus':>6}{'load5':>8}{'cpu%':>7}{'now%':>7}"
        f"{'mem used':>16}{'mem%':>7}{'score':>8}"
    )
    for score, cpu_frac, mem_frac, inst, v in sorted(rows):
        mem_used = v["mem_total"] - v["mem_avail"]
        mem_str = f"{mem_used / gib:.1f}/{v['mem_total'] / gib:.0f} GiB"
        print(
            f"{inst.split('.')[0]:<8}{int(v['cpus']):>6}{v['load5']:>8.2f}{100 * cpu_frac:>6.0f}%"
            f"{100 * v['busy_now']:>6.0f}%{mem_str:>16}{100 * mem_frac:>6.0f}%{score:>8.2f}"
        )


if __name__ == "__main__":
    main()
