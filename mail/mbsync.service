[Unit]
Description=Fetch mail (mbsync) and reindex (notmuch)
Documentation=file:%h/config/mail/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Same handler goimapnotify runs on IDLE, but with no channel argument, so it
# covers every account (the `all` group) rather than the one that woke it.
# Either way it syncs ALL folders, not just INBOX — the channel's Patterns
# decides that, not the caller.
ExecStart=%h/config/mail/on-new-mail.sh
Environment=DISPLAY=:0
