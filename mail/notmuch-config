# notmuch — index and search the Maildir that mbsync writes.
#
# Symlinked to ~/.notmuch-config by install.sh.
#
# Edit this file by hand. `notmuch setup` and `notmuch config set` rewrite the
# config and can replace the symlink with a regular file; if that happens,
# re-run install.sh.

[database]
# absolute, not ~ — notmuch does not expand it in all versions.
# One directory above the per-account maildirs, so more accounts can be
# added under ~/mail/ later and share one index (stored in ~/mail/.notmuch).
path=/home/joseph/mail

[user]
name=Joseph Holten
primary_email=joseph@holten.com
# Every other address that is also you. Without this, notmuch treats mail you
# sent from KIT as mail from a stranger: threads show you as an author and
# `notmuch new` never applies the sent-mail exclusion.
# Semicolon-separated if more are added.
#
# joseph.holten@kit.edu is the address KIT actually puts on outgoing mail (206
# sent / 492 received); np6630@kit.edu is the u-number alias and has never sent
# anything (0 / 5). Both are needed. Everything built from `notmuch-user-emails'
# silently skips whatever is missing here -- reply-all leaves you in the Cc, and
# the emacs address book (`notmuch-address-book' in emacs/init.el) cannot see
# anyone you only ever corresponded with under a missing address.
#
# NOT an identity: wellensfb-docs@lists.kit.edu also shows up as a From in the
# Sent folder. It is a mailing list; adding it would make every list message
# look like mail from you.
other_email=np6630@kit.edu;joseph.holten@kit.edu

[new]
tags=unread;inbox;
# mbsync's per-folder state files live inside the maildir (SyncState *).
# Without this, notmuch tries to index them and errors on every run.
ignore=.mbsyncstate;.mbsyncstate.new;.mbsyncstate.journal;.uidvalidity

[search]
exclude_tags=deleted;spam;

[maildir]
# false keeps notmuch strictly read-only against the maildir: it will not
# rename files to record read/replied state. Flip to true once you want
# unread state to round-trip back to the server (needs Sync All in mbsyncrc).
synchronize_flags=false
