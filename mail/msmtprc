# msmtp — outgoing mail. Symlinked to ~/.msmtprc by install.sh.
#
# No password is stored here: passwordeval shells out to pass, the same entry
# mbsync uses. That also means this file can stay world-readable in the repo —
# msmtp only demands chmod 600 when a literal `password` line is present.
#
# Test with:  echo "test" | msmtp --debug --from=default -t <you@elsewhere>

defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        ~/.msmtp.log

account        holten
# FILL IN / verify against one.com's docs. Port 465 is implicit TLS; for
# STARTTLS instead use port 587 and `tls_starttls on`.
host           send.one.com
port           465
tls_starttls   off
from           joseph@holten.com
user           joseph@holten.com
passwordeval   "pass mail/holten"

account default : holten
