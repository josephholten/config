# msmtp — outgoing mail. Symlinked to ~/.msmtprc by install.sh.
#
# No password is stored here: passwordeval shells out to pass, the same entry
# mbsync uses. That also means this file can stay world-readable in the repo —
# msmtp only demands chmod 600 when a literal `password` line is present.
#
# Test with:  echo "test" | msmtp --debug --from=default -t <you@elsewhere>

defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        ~/.msmtp.log

account        holten
# STARTTLS on 587, which is what one.com recommends. The server also accepts
# implicit TLS on 465 (verified: both negotiate fine) -- for that variant use
# `port 465` + `tls_starttls off`.
host           send.one.com
port           587
tls_starttls   on
from           joseph@holten.com
user           joseph@holten.com
passwordeval   "pass mail/holten"

account        kit
# `user` is the KIT account name, `from` the address it sends as — they differ,
# unlike holten where both are the address. Credential is the top-level
# `pass kit`, not mail/kit. Verify host/port against the SCC docs.
host           smtp.kit.edu
port           587
tls_starttls   on
from           np6630@kit.edu
user           np6630
passwordeval   "pass kit"

# Same mailbox as `kit`, reachable under a second address. It needs its own
# block because msmtp matches `from` literally: notmuch-config lists
# joseph.holten@kit.edu in other_email, so the emacs sender prompt offers it,
# and without a matching account it would fall through to `default` below and
# leave via one.com carrying a kit.edu From — SPF/DMARC bait, and filed into
# KIT's Sent by notmuch-fcc-dirs regardless. `user` stays the account name.
account        kit-alias
host           smtp.kit.edu
port           587
tls_starttls   on
from           joseph.holten@kit.edu
user           np6630
passwordeval   "pass kit"

# Emacs passes -f <From: header> (message-sendmail-envelope-from 'header), and
# msmtp picks the account whose `from` matches it — so replying from the KIT
# address routes through KIT without any per-message setup. Anything with no
# match falls back to this default.
account default : holten
